# URL de conexión a PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/clinica?schema=public"

# Clave secreta para JWT (mínimo 10 caracteres)
JWT_SECRET="tu_clave_secreta_super_segura_aqui"

# Código aleatorio de al menos 32 caracteres para crear la cuenta inicial GERENCIA.
# Configúralo también como variable secreta en el servicio de backend.
GERENCIA_BOOTSTRAP_TOKEN=""

# Puerto del servidor
PORT=3000

# Orígenes del frontend permitidos para CORS (separados por comas)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174